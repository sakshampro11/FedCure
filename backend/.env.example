# Local API configuration. Copy this file to backend/.env; never commit the copy.
APP_ENV=development
DATABASE_URL=sqlite:///./fedcure.db
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
REGISTRATION_TOKEN=replace-with-a-separate-random-enrollment-code-at-least-32-characters-long
ALLOWED_ORIGINS=http://localhost:3000
REQUIRED_HOSPITALS=4
ACCESS_TOKEN_MINUTES=480
